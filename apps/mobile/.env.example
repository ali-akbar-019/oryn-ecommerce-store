# Usually you do NOT need to set this. The app auto-detects your computer's
# LAN IP from the same connection Expo used to load the app on your phone.
#
# Only set this manually if auto-detection fails (e.g. phone and computer on
# different networks, VPN, or a firewall blocking discovery). Replace
# 192.168.1.50 with your computer's actual LAN IP (run `ipconfig` on Windows
# or `ifconfig`/`ip a` on Mac/Linux to find it), and make sure your phone and
# computer are on the same WiFi network.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000/api
