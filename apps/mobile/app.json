{
  "expo": {
    "name": "ORYN",
    "slug": "oryn",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "oryn",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.oryn.store"
    },
    "ios": {
      "bundleIdentifier": "com.oryn.store"
    }
  }
}
